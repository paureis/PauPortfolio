{
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": ["/_next/*", "/scene/*", "/data/*", "/*.{png,jpg,svg,ico,pdf,txt,xml,json}"]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
